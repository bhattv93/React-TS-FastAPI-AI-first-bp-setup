# Copy to backend/.env for local development. `.env` is gitignored - never commit it.
# Every field of app.core.config.Settings must appear here (a unit test enforces this).

# Runtime environment: local | test | dev | staging | prod
APP_ENV=local

# Application version reported by /health (the CD pipeline injects the git SHA).
APP_VERSION=0.0.0-dev

# SQLAlchemy async URL. The default matches `just db-up` (the compose database is published on
# 127.0.0.1:5433 so it does not clash with a PostgreSQL already installed on port 5432).
APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app

# Log level: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# Where the app runs: uvicorn (ECS / local) | lambda (smaller DB pool, see docs/06-delivery/aws-backend.md)
APP_RUNTIME=uvicorn

# Allowed browser origins, as a JSON list. Empty in deployed envs (same-origin through CloudFront).
APP_CORS_ORIGINS=["http://localhost:5173"]

# Placeholder secret for future auth/signing. Use a long random value outside local development.
APP_SECRET_KEY=change-me-locally
