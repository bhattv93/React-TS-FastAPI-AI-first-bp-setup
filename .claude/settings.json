{
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "code-review-anthropics@anthropic-plugin-directory": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true
  },
  "model": "sonnet",
  "enableAllProjectMcpServers": false,
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(docker compose *)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(aws cloudformation deploy*)",
      "Bash(aws cloudformation delete-stack*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(flyway clean*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_protected_files.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/format_changed_file.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
