  "info": {
    "title": "AI-First Backend",
    "version": "0.0.0-dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Report that the process is alive (no dependencies are checked).\n\nParameters\n----------\nsettings : Settings\n    Application settings.\n\nReturns\n-------\nHealthResponse\n    Status, application version and environment name.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Report whether the app can serve traffic (database reachable).\n\nParameters\n----------\nsession : AsyncSession\n    Database session for the connectivity probe.\n\nReturns\n-------\nReadyResponse or JSONResponse\n    ``ok`` when the database answers, otherwise a 503 error envelope.",
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
