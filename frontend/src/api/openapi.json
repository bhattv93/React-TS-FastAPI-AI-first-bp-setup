        "properties": {
          "env": {
            "title": "Env",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "env"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "description": "Readiness payload.",
        "properties": {
          "database": {
            "title": "Database",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
